# ==============================================================================
# Environment Configuration Template
# Copy this file to .env and fill in your private credentials.
# NEVER commit the actual .env file to Git!
# ==============================================================================

# Comet ML Credentials (Optional - for experiment tracking in NFN / SS models)
COMET_API_KEY=your_comet_api_key_here
COMET_PROJECT_NAME=lsdc-sip
COMET_WORKSPACE=your_comet_workspace_here

# Weights & Biases Credentials (Optional - for experiment tracking in SCS models)
WANDB_API_KEY=your_wandb_api_key_here
WANDB_PROJECT=lsdc_yolo11

# Device Configuration ('0', '0,1', or 'cpu')
CUDA_VISIBLE_DEVICES=0
